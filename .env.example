# .env del bot de WhatsApp (VPS)
# Copia este archivo a /root/porra-bot/.env y rellena los valores.
# Cárgalo SIEMPRE en la shell antes de arrancar pm2 (pm2 no honra env_file):
#   set -a && source .env && set +a && pm2 start ecosystem.config.cjs --update-env

# --- Obligatorias ---

# Token Bearer que autentica los POST del cron (/publish, /sync).
# Genéralo con: openssl rand -hex 32
# El mismo valor va al secret VPS_WEBHOOK_TOKEN de GitHub Actions.
VPS_WEBHOOK_TOKEN=cambiame-token-aleatorio-hex

# Mapeo grupo de WhatsApp -> id de porra. Habilita los comandos (!ranking...).
# ⚠️ ENTRE COMILLAS SIMPLES: si no, `source .env` se come las comillas dobles
# del JSON. Los IDs de grupo los imprime el bot en consola al arrancar.
# Los grupos NO listados aquí se ignoran en silencio.
POOL_GROUPS='{"120363000000000001@g.us":"ejemplo"}'

# PAT fine-grained de GitHub (solo tu repo, permiso Actions: Read and write).
# Con él el dispatcher del bot lanza el workflow del cron alrededor de cada
# kickoff. Sin él no corre nada: el workflow no tiene schedule propio.
GH_DISPATCH_TOKEN=tu-fine-grained-pat-de-github

# Repo contra el que dispara el dispatcher, formato owner/repo.
GH_REPO=tu-usuario/tu-repo

# --- Recomendadas ---

# Habilita el comando !claudio/!bot (chat con IA para todo el grupo,
# rate limit 10 mensajes/24 h por persona). Sin ella, el comando responde
# que la IA no está configurada.
ANTHROPIC_API_KEY=tu-api-key-de-anthropic

# JID de WhatsApp del organizador, exento del rate limit del !claudio.
# En grupos modernos suele ser "<id>@lid" (no "<numero>@c.us"): míralo en los
# logs del bot cuando escribas en el grupo.
ORGANIZER_JID=00000000000000@lid

# --- Opcionales ---

# Canal de ntfy.sh para recibir push en el móvil si WhatsApp se desconecta.
# Mismo valor en el secret NTFY_TOPIC de GitHub (workflow de vigilancia).
#NTFY_TOPIC=mi-canal-secreto

# Mapeo slug secreto -> porra para el panel web (GET /web/<slug>).
# Mismas comillas simples que POOL_GROUPS.
#WEB_SLUGS='{"un-slug-dificil-de-adivinar":"ejemplo"}'

# Puerto HTTP interno (Caddy hace de reverse proxy delante).
#PORT=8443
